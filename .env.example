# AURA — Environment Variables Template
# Copy to api/.env and web/.env.local for local development. NEVER commit real secrets.

# --- Environment ---
AURA_ENV=local                  # "local" or "production" (non-local refuses placeholder APPROVAL_TOKEN_SECRET)

# --- Google Cloud & Vertex AI / Gemini (Single Canonical Model ID) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.8-flash

# --- Backend Runtime ---
PORT=8080
AURA_STORE_MODE=memory          # "memory" for unit tests, "firestore" for Firestore emulator / GCP
DEMO_CAFE_ID=demo-cafe
ALLOW_DEMO_AUTH=false           # Secure default: false. Only set true for isolated demo-cafe showcase
DEMO_STAFF_PASSCODE=            # Required for barista/manager demo tokens (inject via Secret Manager in prod)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DAILY_AI_BUDGET_REQUESTS=200
PER_USER_DAILY_AI_LIMIT=30
PER_GUEST_IP_DAILY_LIMIT=10
PER_USER_AI_RPM=10
APPROVAL_TOKEN_SECRET=local-dev-ephemeral-secret-change-in-prod

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_CAFE_ID=demo-cafe
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
